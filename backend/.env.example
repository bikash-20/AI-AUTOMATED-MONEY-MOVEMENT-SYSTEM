# --- App ---
APP_HOST=127.0.0.1
APP_PORT=8000
DB_PATH=./wallet.db
PENDING_TTL_SECONDS=60
SWEEPER_INTERVAL_SECONDS=5

# --- LLM cascade (intent parser + phraser) ---
# First successful, non-empty response wins.
OLLAMA_URL=http://localhost:11434
LLM_CASCADE=deepseek-coder-v2:16b

# --- TTS ---
# edge | qwen | off
TTS_ENGINE=qwen
EDGE_TTS_VOICE=en-US-AriaNeural
QWEN_TTS_MODEL=Qwen/Qwen3-TTS-12Hz-0.6B-CustomVoice
QWEN_TTS_VOICE=Ryan
QWEN_TTS_LANG=English

# --- STT ---
STT_MODEL=base
STT_COMPUTE=int8

# --- Demo seed ---
# Override starting balances (BDT). Default: bikash=50000, others=10000
SEED_BALANCE_BIKASH=50000
SEED_BALANCE_DEFAULT=10000
